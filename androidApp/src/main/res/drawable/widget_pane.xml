<?xml version="1.0" encoding="utf-8"?>
<!-- The app's glow, made to fit a widget: its three colours across the pane, pink to blue. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_pane" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="@color/widget_glow_middle"
                android:endColor="@color/widget_glow_right"
                android:startColor="@color/widget_glow_left"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
