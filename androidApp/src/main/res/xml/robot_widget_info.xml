<?xml version="1.0" encoding="utf-8"?>
<!--
  Two cells by one, and wider if wanted. The half-hourly update is all the asking it does on its
  own; see RobotWidget for the rest.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_robot"
    android:minHeight="50dp"
    android:minResizeHeight="50dp"
    android:minResizeWidth="110dp"
    android:minWidth="130dp"
    android:previewLayout="@layout/widget_robot"
    android:resizeMode="horizontal"
    android:targetCellHeight="1"
    android:targetCellWidth="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
