<?xml version="1.0" encoding="utf-8"?>
<!--
  Three cells by one: the ring, the words and a room's initial for each room there is width for;
  made one cell wide it is only the ring. See RobotWidget for when it asks the robot.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_ring_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minHeight="50dp"
    android:minResizeHeight="50dp"
    android:minResizeWidth="50dp"
    android:minWidth="180dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="3"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
