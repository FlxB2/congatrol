<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The robot is spoken to over the home network. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Cleartext on purpose: the robot's own web server speaks plain HTTP and nothing else, and it
      is only ever reached on the local network.
    -->
    <application
            android:allowBackup="false"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:name=".CongatrolApp"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.Congatrol"
            android:usesCleartextTraffic="true">
        <!-- Portrait only: nothing in the app is laid out for landscape and nothing tests it. -->
        <activity
                android:exported="true"
                android:launchMode="singleTask"
                android:screenOrientation="portrait"
                android:windowSoftInputMode="adjustResize"
                android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- The widget's three looks. Exported because the launcher is who sends the updates. -->
        <receiver
                android:exported="true"
                android:label="@string/widget_clear_name"
                android:name=".widget.ClearWidgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/clear_widget_info"/>
        </receiver>
        <receiver
                android:exported="true"
                android:label="@string/widget_ring_name"
                android:name=".widget.RingWidgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/ring_widget_info"/>
        </receiver>
        <receiver
                android:exported="true"
                android:label="@string/widget_floorplan_name"
                android:name=".widget.FloorplanWidgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/floorplan_widget_info"/>
        </receiver>
    </application>

</manifest>
